{
  "contract": "orqena.first-party-events",
  "version": 1,
  "contentPolicy": "no-free-text-no-direct-identifiers",
  "events": {
    "user.active": { "properties": { "surface": ["app", "mobile", "public"] } },
    "activation.company.completed": { "properties": { "milestone": ["company"], "withinSevenDays": "boolean", "measurementVersion": ["f7-v1"] } },
    "activation.client.completed": { "properties": { "milestone": ["client"], "withinSevenDays": "boolean", "measurementVersion": ["f7-v1"] } },
    "activation.budget.completed": { "properties": { "milestone": ["budget"], "withinSevenDays": "boolean", "measurementVersion": ["f7-v1"] } },
    "activation.document.completed": { "properties": { "milestone": ["document"], "withinSevenDays": "boolean", "measurementVersion": ["f7-v1"] } },
    "activation.completed": { "properties": { "milestone": ["all"], "withinSevenDays": "boolean", "measurementVersion": ["f7-v1"] } },
    "onboarding.session": { "properties": { "durationMinutes": "number", "completed": "boolean", "version": ["v1"] } },
    "outcome.time_saved": { "properties": { "minutes": "number", "methodology": ["self_reported", "workflow_baseline_v1"] } },
    "outcome.debt_recovered": { "properties": { "amountEur": "number", "methodology": ["overdue_payment_v1"] } },
    "outcome.ai_action": { "properties": { "outcome": ["accepted", "corrected", "rejected"], "minutesSaved": "number" } },
    "feedback.nps": { "properties": { "score": "number", "consent": ["explicit"] } },
    "feedback.csat": { "properties": { "score": "number", "consent": ["explicit"] } },
    "support.session": { "properties": { "minutes": "number", "category": ["ACCESS", "BILLING", "DOCUMENTS", "OPERATIONS", "PRIVACY", "OTHER"] } },
    "web.vital": { "properties": { "metric": ["LCP", "CLS", "INP", "FCP", "TTFB"], "value": "number", "rating": ["good", "needs-improvement", "poor"], "routeGroup": ["public", "auth", "app", "platform"] } }
  }
