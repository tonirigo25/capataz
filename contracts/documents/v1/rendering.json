{
  "contract": "orqena.document-rendering",
  "version": 1,
  "templateVersion": "orqena-professional-v1",
  "formats": ["application/pdf"],
  "kinds": ["budget", "invoice"],
  "encoding": "WinAnsi",
  "companyAsset": {
    "source": "private-verified-storage",
    "acceptedMimeTypes": ["image/jpeg"],
    "invalidAssetBehavior": "deterministic-brand-fallback"
  },
  "headers": ["X-Orqena-Template-Version", "X-Orqena-PDF-SHA256"],
  "goldenFixture": "scripts/validate-document-pdf.mjs",
  "mustSupport": ["spanish-diacritics", "multipage", "tenant-scoped-logo", "deterministic-output"]
}
