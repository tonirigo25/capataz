{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orqena.invalid/contracts/events/v1/envelope.schema.json",
  "title": "Orqena event envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "eventType", "schemaVersion", "companyId", "occurredAt", "correlationId", "idempotencyKey", "payload"],
  "properties": {
    "eventId": { "type": "string", "minLength": 1 },
    "eventType": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]+$" },
    "schemaVersion": { "const": 1 },
    "companyId": { "type": "string", "minLength": 1 },
    "occurredAt": { "type": "string", "format": "date-time" },
    "correlationId": { "type": "string", "minLength": 1 },
    "causationId": { "type": ["string", "null"] },
    "idempotencyKey": { "type": "string", "minLength": 1 },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["user", "system", "provider"] },
        "id": { "type": ["string", "null"] }
      },
      "required": ["type"]
    },
    "payload": { "type": "object" }
  }
}
