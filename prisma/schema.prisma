model Client {
  id                        String             @id @default(cuid())
  companyId                 String?
  nombre                    String
  nombreComercial           String?
  razonSocial               String?
  nifCif                    String?
  telefono                  String
  email                     String?
  direccion                 String
  direccionFiscal           String?
  codigoPostal              String?
  municipio                 String?
  provincia                 String?
  pais                      String             @default("España")
  emailFacturacion          String?
  telefonoFacturacion       String?
  contactoPrincipalNombre   String?
  contactoPrincipalCargo    String?
  contactoPrincipalTelefono String?
  contactoPrincipalEmail    String?
  contactoFacturacionNombre String?
  tipo                      String
  estado                    ClientStatus       @default(nuevo)
  origen                    String
  notas                     String?
  fechaCreacion             DateTime           @default(now())
  ultimaInteraccion         DateTime?
  archivadoAt               DateTime?
  budgets                   Budget[]
  contacts                  Contact[]
  documents                 Document[]
  expenses                  Expense[]
  invoices                  Invoice[]
  internalNotes             InternalNote[]
  payments                  Payment[]
  cashMovements             CashMovement[]
  expectedCashFlows         ExpectedCashFlow[]
  reminders                 Reminder[]
  works                     Work[]
  agendaEvents              EventoAgenda[]
  company                   Company?           @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([nombre])
  @@index([nifCif])
  @@index([email])
  @@index([telefono])
  @@index([estado])
  @@index([archivadoAt])
  @@index([companyId])
}

model Work {
  id                         String                @id @default(cuid())
  companyId                  String?
  numeroInterno              String?
  codigo                     String?
  clienteId                  String
  contactoId                 String?
  contactoPrincipal          String?
  contactoTelefono           String?
  contactoEmail              String?
  titulo                     String
  direccion                  String
  latitud                    Float?
  longitud                   Float?
  tipoTrabajo                String
  estado                     WorkStatus            @default(pendiente_inicio)
  prioridad                  WorkPriority          @default(media)
  fechaCreacion              DateTime              @default(now())
  fechaInicioPrevista        DateTime?
  fechaInicio                DateTime?
  fechaInicioReal            DateTime?
  fechaFinPrevista           DateTime?
  fechaFinReal               DateTime?
  responsable                String?
  comercial                  String?
  jefeObra                   String?
  descripcion                String?
  observacionesInternas      String?
  notasPrivadas              String?
  presupuestoAprobado        Float
  presupuestoAprobadoDecimal Decimal?              @db.Decimal(18, 2)
  costePrevisto              Float                 @default(0)
  costePrevistoDecimal       Decimal?              @db.Decimal(18, 2)
  gastoReal                  Float                 @default(0)
  gastoRealDecimal           Decimal?              @db.Decimal(18, 2)
  margenEstimado             Float                 @default(0)
  margenEstimadoDecimal      Decimal?              @db.Decimal(18, 2)
  horasEstimadas             Float                 @default(0)
  horasReales                Float                 @default(0)
  subcontratasCoste          Float                 @default(0)
  archivada                  Boolean               @default(false)
  archivadaAt                DateTime?
  notas                      String?
  updatedAt                  DateTime              @updatedAt
  budgets                    Budget[]
  client                     Client                @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  contact                    Contact?              @relation("WorkSiteContact", fields: [contactoId], references: [id], onDelete: SetNull)
  repositoryDocuments        Document[]
  documents                  WorkDocument[]
  expenses                   Expense[]
  partnerLinks               BusinessPartnerWork[]
  purchaseInvoices           PurchaseInvoice[]
  preferredByPartners        PartnerLearning[]     @relation("PartnerPreferredWork")
  internalNotes              InternalNote[]
  photos                     WorkPhoto[]
  invoices                   Invoice[]
  materials                  Material[]
  payments                   Payment[]
  cashMovements              CashMovement[]
  expectedCashFlows          ExpectedCashFlow[]
  recurringExpenses          RecurringExpense[]
  reminders                  Reminder[]
  agendaEvents               EventoAgenda[]
  company                    Company?              @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, numeroInterno])
  @@unique([companyId, codigo])
  @@index([estado])
  @@index([prioridad])
  @@index([fechaInicioPrevista])
  @@index([fechaFinPrevista])
  @@index([archivada])
  @@index([contactoId])
  @@index([companyId])
}

model Contact {
  id               String         @id @default(cuid())
  companyId        String?
  clientId         String
  nombre           String
  apellidos        String?
  cargo            String?
  telefono         String?
  email            String?
  isPrimary        Boolean        @default(false)
  isBillingContact Boolean        @default(false)
  isSiteContact    Boolean        @default(false)
  notes            String?
  archivedAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  client           Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  agendaEvents     EventoAgenda[]
  reminders        Reminder[]
  worksAsSite      Work[]         @relation("WorkSiteContact")
  company          Company?       @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([clientId])
  @@index([email])
  @@index([telefono])
  @@index([archivedAt])
  @@index([companyId])
}

model WorkDocument {
  id         String   @id @default(cuid())
  obraId     String
  tipo       String
  nombre     String
  url        String?
  entityType String?
  entityId   String?
  notas      String?
  fecha      DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  work       Work     @relation(fields: [obraId], references: [id], onDelete: Cascade)

  @@index([obraId])
  @@index([tipo])
  @@index([entityType, entityId])
}

model WorkPhoto {
  id         String    @id @default(cuid())
  obraId     String
  documentId String?   @unique
  categoria  String
  titulo     String
  url        String?
  autor      String?
  ubicacion  String?
  notas      String?
  tomadaEn   DateTime  @default(now())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  document   Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  work       Work      @relation(fields: [obraId], references: [id], onDelete: Cascade)

  @@index([obraId])
  @@index([categoria])
}

model Budget {
  id                    String         @id @default(cuid())
  companyId             String?
  clienteId             String
  obraId                String?
  numero                String
  titulo                String
  partidas              String
  subtotal              Float
  subtotalDecimal       Decimal?       @db.Decimal(18, 2)
  iva                   Float
  ivaDecimal            Decimal?       @db.Decimal(18, 2)
  descuento             Float          @default(0)
  descuentoDecimal      Decimal?       @db.Decimal(18, 2)
  total                 Float
  totalDecimal          Decimal?       @db.Decimal(18, 2)
  margenEstimado        Float
  margenEstimadoDecimal Decimal?       @db.Decimal(18, 2)
  estado                BudgetStatus   @default(borrador)
  fechaCreacion         DateTime       @default(now())
  fechaEnvio            DateTime?
  fechaValidez          DateTime?
  fechaSeguimiento      DateTime?
  condiciones           String?
  observaciones         String?
  formaPago             String?
  client                Client         @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  agendaEvents          EventoAgenda[]
  documents             Document[]
  internalNotes         InternalNote[]
  reminders             Reminder[]
  work                  Work?          @relation(fields: [obraId], references: [id])
  company               Company?       @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, numero])
  @@index([companyId])
}

model Invoice {
  id                 String             @id @default(cuid())
  companyId          String?
  clienteId          String
  obraId             String?
  numero             String
  concepto           String
  partidas           String?
  importeBase        Float
  importeBaseDecimal Decimal?           @db.Decimal(18, 2)
  iva                Float
  ivaDecimal         Decimal?           @db.Decimal(18, 2)
  total              Float
  totalDecimal       Decimal?           @db.Decimal(18, 2)
  pagado             Float              @default(0)
  pagadoDecimal      Decimal?           @db.Decimal(18, 2)
  pendiente          Float
  pendienteDecimal   Decimal?           @db.Decimal(18, 2)
  fechaEmision       DateTime
  fechaVencimiento   DateTime
  estado             InvoiceStatus      @default(pendiente_pago)
  observaciones      String?
  metodoPago         String?
  datosBancarios     String?
  cashMovements      CashMovement[]
  client             Client             @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  agendaEvents       EventoAgenda[]
  documents          Document[]
  expectedCashFlows  ExpectedCashFlow[]
  internalNotes      InternalNote[]
  payments           Payment[]
  reminders          Reminder[]
  work               Work?              @relation(fields: [obraId], references: [id])
  company            Company?           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  fiscalDocuments    FiscalDocument[]

  @@unique([companyId, numero])
  @@index([companyId])
}

model Payment {
  id             String         @id @default(cuid())
  companyId      String?
  facturaId      String
  clienteId      String
  obraId         String?
  importe        Float
  importeDecimal Decimal?       @db.Decimal(18, 2)
  metodo         String
  fecha          DateTime       @default(now())
  tipo           PaymentType
  notas          String?
  cashMovements  CashMovement[]
  client         Client         @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  invoice        Invoice        @relation(fields: [facturaId], references: [id], onDelete: Cascade)
  work           Work?          @relation(fields: [obraId], references: [id])
  company        Company?       @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId])
}

model Expense {
  id                String             @id @default(cuid())
  companyId         String?
  obraId            String?
  clienteId         String?
  businessPartnerId String?
  purchaseInvoiceId String?            @unique
  proveedor         String
  concepto          String
  categoria         ExpenseCategory
  importe           Float
  importeDecimal    Decimal?           @db.Decimal(18, 2)
  fecha             DateTime
  paymentStatus     ExpenseCashStatus?
  paymentDueDate    DateTime?
  paidAt            DateTime?
  costBehavior      CostBehavior       @default(unknown)
  fotoTicketUrl     String?
  notas             String?
  cashMovements     CashMovement[]
  client            Client?            @relation(fields: [clienteId], references: [id])
  documents         Document[]
  expectedCashFlows ExpectedCashFlow[]
  work              Work?              @relation(fields: [obraId], references: [id], onDelete: SetNull)
  businessPartner   BusinessPartner?   @relation(fields: [businessPartnerId], references: [id], onDelete: SetNull)
  purchaseInvoice   PurchaseInvoice?   @relation(fields: [purchaseInvoiceId], references: [id], onDelete: SetNull)
  company           Company?           @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@index([businessPartnerId])
}

model FinancialAccount {
  id                          String               @id @default(cuid())
  companyId                   String?
  name                        String
  type                        FinancialAccountType @default(bank)
  currency                    String               @default("EUR")
  openingBalance              Float                @default(0)
  openingBalanceDecimal       Decimal?             @db.Decimal(18, 2)
  currentManualBalance        Float?
  currentManualBalanceDecimal Decimal?             @db.Decimal(18, 2)
  manualBalanceUpdatedAt      DateTime?
  minimumBalance              Float?
  minimumBalanceDecimal       Decimal?             @db.Decimal(18, 2)
  isActive                    Boolean              @default(true)
  createdAt                   DateTime             @default(now())
  updatedAt                   DateTime             @updatedAt
  archivedAt                  DateTime?
  movements                   CashMovement[]
  company                     Company?             @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([isActive])
  @@index([archivedAt])
  @@index([companyId])
}

model CashMovement {
  id              String             @id @default(cuid())
  companyId       String?
  accountId       String
  type            CashMovementType
  amount          Float
  amountDecimal   Decimal?           @db.Decimal(18, 2)
  date            DateTime
  description     String
  invoiceId       String?
  paymentId       String?            @unique
  expenseId       String?            @unique
  workId          String?
  clientId        String?
  category        String?
  provider        String?
  status          CashMovementStatus @default(confirmed)
  source          CashMovementSource @default(manual)
  transferGroupId String?
  notes           String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  archivedAt      DateTime?
  account         FinancialAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  client          Client?            @relation(fields: [clientId], references: [id], onDelete: SetNull)
  expense         Expense?           @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  invoice         Invoice?           @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  payment         Payment?           @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  work            Work?              @relation(fields: [workId], references: [id], onDelete: SetNull)
  company         Company?           @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([accountId, date])
  @@index([type])
  @@index([status])
  @@index([source])
  @@index([invoiceId])
  @@index([workId])
  @@index([clientId])
  @@index([transferGroupId])
  @@index([archivedAt])
  @@index([companyId])
}

model RecurringExpense {
  id                String                    @id @default(cuid())
  companyId         String?
  name              String
  amount            Float
  amountDecimal     Decimal?                  @db.Decimal(18, 2)
  frequency         RecurringExpenseFrequency
  nextDueDate       DateTime
  category          String?
  workId            String?
  provider          String?
  fixedCost         Boolean                   @default(true)
  isActive          Boolean                   @default(true)
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  archivedAt        DateTime?
  work              Work?                     @relation(fields: [workId], references: [id], onDelete: SetNull)
  expectedCashFlows ExpectedCashFlow[]
  company           Company?                  @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([isActive, nextDueDate])
  @@index([workId])
  @@index([archivedAt])
  @@index([companyId])
}

model ExpectedCashFlow {
  id                 String                 @id @default(cuid())
  companyId          String?
  type               ExpectedCashFlowType
  amount             Float
  amountDecimal      Decimal?               @db.Decimal(18, 2)
  expectedDate       DateTime
  description        String
  probability        Float?
  confidenceSource   String?
  invoiceId          String?
  expenseId          String?
  recurringExpenseId String?
  workId             String?
  clientId           String?
  status             ExpectedCashFlowStatus @default(pending)
  source             ExpectedCashFlowSource @default(manual)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  archivedAt         DateTime?
  client             Client?                @relation(fields: [clientId], references: [id], onDelete: SetNull)
  expense            Expense?               @relation(fields: [expenseId], references: [id], onDelete: SetNull)
