// Fiscal ledger (M02). FiscalRecord is append-only by application contract.
model FiscalDocument {
  id                       String                      @id @default(cuid())
  companyId                String
  invoiceId                String?
  issuanceKey              String?
  documentType             String
  series                   String
  number                   String
  issueDate                DateTime
  currency                 String                      @default("EUR")
  taxableBase              Decimal                     @db.Decimal(18, 2)
  discountAmount           Decimal                     @default(0) @db.Decimal(18, 2)
  taxAmount                Decimal                     @db.Decimal(18, 2)
  withholdingAmount        Decimal                     @default(0) @db.Decimal(18, 2)
  total                    Decimal                     @db.Decimal(18, 2)
  status                   String                      @default("DRAFT")
  mode                     String                      @default("off")
  schemaVersion            Int                         @default(1)
  sourceSnapshot           Json
  snapshotHash             String?
  qrPayload                String?
  qrVersion                String?
  correctionKind           String?
  correctionReason         String?
  originalFiscalDocumentId String?
  softwareVersion          String?
  releaseSha               String?
  configurationHash        String?
  legacySource             Boolean                     @default(false)
  retentionUntil           DateTime?
  issuedAt                 DateTime?
  voidedAt                 DateTime?
  createdAt                DateTime                    @default(now())
  updatedAt                DateTime                    @updatedAt
  company                  Company                     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  invoice                  Invoice?                    @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  originalFiscalDocument   FiscalDocument?             @relation("FiscalCorrections", fields: [originalFiscalDocumentId], references: [id], onDelete: Restrict)
  corrections              FiscalDocument[]            @relation("FiscalCorrections")
  records                  FiscalRecord[]
  transmissions            FiscalTransmission[]
  events                   FiscalEvent[]
  electronicArtifacts      ElectronicInvoiceArtifact[]

  @@unique([companyId, series, number])
  @@unique([companyId, issuanceKey])
  @@index([companyId, status, issueDate])
  @@index([companyId, documentType, series, issueDate])
  @@index([originalFiscalDocumentId])
  @@index([invoiceId])
}

