DATABASE_URL=
# Optional. Enables automatic document extraction; leave empty for manual mode.
OPENAI_API_KEY=
# Optional local document root. Defaults to .capataz-documents outside public/.
DOCUMENT_STORAGE_ROOT=
# Optional: openai (default when configured) or deterministic (tests/development only).
DOCUMENT_EXTRACTION_PROVIDER=
# Optional model used by the document reader.
OPENAI_DOCUMENT_MODEL=
OPENAI_MODEL_FAST=gpt-4.1-mini-2025-04-14
OPENAI_MODEL_REASONING=gpt-4.1-2025-04-14
OPENAI_MODEL_TRANSCRIPTION=gpt-4o-mini-transcribe
OPENAI_REASONING_EFFORT=low
OPENAI_MODEL=gpt-4.1-2025-04-14
OPENAI_TIMEOUT_MS=18000
OPENAI_FAST_TIMEOUT_MS=10000
OPENAI_REASONING_TIMEOUT_MS=30000
NEXT_PUBLIC_APP_MODE=test
NEXT_PUBLIC_APP_ENV=staging
ORQENA_PUBLIC_REGISTRATION_ENABLED=false
PUBLIC_INDEXING_ENABLED=false
PUBLIC_PRICING_ENABLED=false
PUBLIC_PRICING_APPROVAL_REF=
PUBLIC_PRICE_CATALOG_VERSION=
NEXT_PUBLIC_WEB_BASE_URL=https://app.orqenatech.com
NEXT_PUBLIC_MARKETING_URL=https://orqenatech.com
NEXT_PUBLIC_APP_HOST=app.orqenatech.com
NEXT_PUBLIC_SUPPORT_EMAIL=soporte@orqenatech.com

# Mobile wrapper: release (safe default), staging or development.
CAPATAZ_MOBILE_MODE=release
CAPATAZ_MOBILE_SERVER_URL=

# Identity and transactional email (never commit real values)
APP_BASE_URL=https://app.orqenatech.com
EMAIL_FROM=Capataz · Orqena Tech <notificaciones@updates.orqenatech.com>
RESEND_FROM_EMAIL=Capataz · Orqena Tech <notificaciones@updates.orqenatech.com>
# Deprecated compatibility alias. New environments use EMAIL_REPLY_TO.
RESEND_REPLY_TO=
RESEND_API_KEY=
# Use only in development, test, or staging. It records sanitized delivery metadata and sends nothing externally.
EMAIL_PROVIDER=local
AUTH_SESSION_DAYS=30
AUTH_VERIFICATION_TOKEN_MINUTES=1440
AUTH_RESET_TOKEN_MINUTES=30
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOCK_MINUTES=15

# Readiness identity and canonical URLs
PRODUCT_NAME=Orqena
NEXT_PUBLIC_PRODUCT_NAME=Orqena
LEGAL_ENTITY_NAME=
LEGAL_TAX_ID=
NEXT_PUBLIC_LEGAL_PRODUCT_NAME=Orqena
NEXT_PUBLIC_LEGAL_COMPANY_NAME=
EMAIL_REPLY_TO=soporte@orqenatech.com
EMAIL_SENDING_DOMAIN=updates.orqenatech.com
EMAIL_DKIM_STATUS=
EMAIL_SPF_STATUS=
EMAIL_DMARC_POLICY=
EMAIL_TRACKING_ENABLED=false
EMAIL_TOKEN_DERIVATION_SECRET=

# All new engines are fail-closed by default.
FISCAL_ENGINE_ENABLED=false
BILLING_ENABLED=false
EMAIL_LIVE_ENABLED=false
AI_ENABLED=false
ANALYTICS_ENABLED=false
DEMO_LEAD_RETENTION_ENABLED=false
DEMO_LEAD_RETENTION_DAYS=90

# Application encryption keyring. Never commit real values.
APP_ENCRYPTION_KEYS=
APP_ACTIVE_KEY_VERSION=

# Email provider verification
RESEND_WEBHOOK_SECRET=

# AI governance
OPENAI_BASE_URL=
OPENAI_PROJECT_ID=
OPENAI_DATA_PROFILE=
OPENAI_MODEL_FAST_SNAPSHOT=gpt-4.1-mini-2025-04-14
OPENAI_MODEL_REASONING_SNAPSHOT=gpt-4.1-2025-04-14
OPENAI_MODEL_TRANSCRIPTION_SNAPSHOT=gpt-4o-mini-transcribe-2025-12-15
OPENAI_STORE=false
AI_PROVIDER_MODE=off
AI_PROVIDER_CONFIGURED=false
AI_GLOBAL_ENABLED=false
AI_VOICE_ENABLED=false
AI_LIVE_APPROVAL=
AI_COMPANY_ALLOWLIST=
AI_GLOBAL_MONTHLY_BUDGET_EUR=25
AI_DEFAULT_COMPANY_MONTHLY_BUDGET_EUR=5
AI_DEFAULT_USER_DAILY_REQUEST_LIMIT=50
AI_MAX_INPUT_TOKENS_PER_REQUEST=4000
AI_MAX_OUTPUT_TOKENS_PER_REQUEST=1000

# Private object storage (local is development-only)
STORAGE_PROVIDER=local
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
STORAGE_SIGNING_SECRET=
PRIVATE_STORAGE_ROOT=
MALWARE_SCAN_ENDPOINT=
MALWARE_SCAN_AUTHORIZATION=

# Managed-environment isolation. IDs/fingerprints identify resources but never contain credentials.
DEPLOYMENT_ENVIRONMENT_ID=
DATABASE_RESOURCE_ID=
STORAGE_RESOURCE_ID=
CREDENTIAL_SCOPE=
PRODUCTION_DATABASE_RESOURCE_ID=
PRODUCTION_STORAGE_RESOURCE_ID=
PRODUCTION_DATABASE_URL_SHA256=
STAGING_DATABASE_RESOURCE_ID=
STAGING_STORAGE_RESOURCE_ID=
STAGING_DATABASE_URL_SHA256=

# Observability and jobs
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
ERROR_TRACKING_DSN=
JOB_RUNNER_SECRET=

# Fiscal provider: off, sandbox, or live
FISCAL_MODE=off
FISCAL_PROVIDER=
FISCAL_CERTIFICATE_REF=
FISCAL_SOFTWARE_VERSION=

# Consent and product analytics
NEXT_PUBLIC_CONSENT_MODE=essential-only
ANALYTICS_PROVIDER=
NEXT_PUBLIC_ASSISTANT_NAME=Orqena
NEXT_PUBLIC_BRAND_TAGLINE=Tu negocio, en orden.
NEXT_PUBLIC_SUPPORT_NAME=Soporte de Orqena
NEXT_PUBLIC_SENDER_NAME=Orqena
NEXT_PUBLIC_BRAND_MARK=/brand/mark.svg
NEXT_PUBLIC_BRAND_WORDMARK=Orqena
NEXT_PUBLIC_SOCIAL_IMAGE=/brand/social-card.svg
NEXT_PUBLIC_BRAND_COLOR=#087A68
NEXT_PUBLIC_BRAND_STRONG_COLOR=#07594E
NEXT_PUBLIC_INFORMATION_COLOR=#0755C9
NEXT_PUBLIC_PWA_NAME=Orqena
NEXT_PUBLIC_PWA_SHORT_NAME=Orqena
NEXT_PUBLIC_PWA_ICON=/brand/app-icon.svg
NEXT_PUBLIC_PWA_MASKABLE_ICON=/brand/icon-maskable-512.png
CAPATAZ_MOBILE_APP_ID=com.orqena.app
CAPATAZ_MOBILE_APP_NAME=Orqena
CAPATAZ_MOBILE_URL_SCHEME=orqena
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_LEGAL_REGISTRATION=
NEXT_PUBLIC_PRIVACY_EMAIL=
NEXT_PUBLIC_LEGAL_DOCUMENT_VERSION=1.0-draft

# Private object storage (Cloudflare R2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_REGION=auto
R2_PRESIGNED_URL_TTL_SECONDS=600

# Stripe Billing v1. Sandbox and Live use different values. Never copy IDs or
# secrets between environments. Billing stays disabled until final authorization.
BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Canonical price source: plan + interval. Price IDs are environment-specific.
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_ANNUAL=
STRIPE_PORTAL_CONFIGURATION_ID=
STRIPE_TRIAL_DAYS=3
BILLING_PAST_DUE_GRACE_DAYS=3
BILLING_ALLOWED_COUNTRIES=ES
EU_B2B_CROSS_BORDER_ENABLED=false

# Remote Sandbox validation is read-only by default and always rejects Live
# keys. The separate write opt-in creates only disposable Sandbox fixtures and
# removes them before the runner exits.
STRIPE_REMOTE_SANDBOX_ENABLED=false
STRIPE_SANDBOX_REMOTE_ALLOW_WRITES=false
STRIPE_REMOTE_SANDBOX_WEBHOOK_URL=

# Deprecated compatibility aliases. Leave empty in new environments. If a
# canonical and legacy value coexist, readiness rejects any ambiguity.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_KEYS=

# Legal identity: omit until verified; public pages fail closed without invented data.
LEGAL_ENTITY_NAME=
LEGAL_TAX_ID=
LEGAL_ADDRESS=
LEGAL_REGISTRY_DETAILS=
LEGAL_CONTACT_EMAIL=
PRIVACY_CONTACT_EMAIL=
