{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "Orqena Field OS V2",
    "version": "2.0.0",
    "date": "2026-07-30",
    "intent": "Premium dark public brand + calm, compact operational SaaS"
  },
  "color": {
    "ink": {
      "value": "#101814",
      "role": "Primary text, dark surfaces"
    },
    "dark2": {
      "value": "#17212C",
      "role": "Elevated dark surfaces"
    },
    "inkMuted": {
      "value": "#66736C"
    },
    "stone": {
      "value": "#F5F7F6",
      "role": "Application canvas"
    },
    "paper": {
      "value": "#F5F7F6"
    },
    "surface": {
      "value": "#FFFFFF"
    },
    "line": {
      "value": "#D8DED7"
    },
    "lime": {
      "value": "#20B862",
      "role": "Primary action and confirmation accent"
    },
    "greenSoft": {
      "value": "#E7F7EE",
      "role": "Soft success and selected surface"
    },
    "blue": {
      "value": "#2D5DE0",
      "role": "Information and commercial flow"
    },
    "orange": {
      "value": "#D58A1F",
      "role": "Attention"
    },
    "red": {
      "value": "#C8453B",
      "role": "Risk"
    },
    "green": {
      "value": "#168C55",
      "role": "Success"
    }
  },
  "semanticColor": {
    "successText": {
      "value": "#137A49",
      "source": "green",
      "role": "AA success text on surface and greenSoft"
    },
    "textMuted": {
      "value": "#5B6761",
      "source": "inkMuted",
      "role": "AA text on stone, paper, surface and lime"
    },
    "warningText": {
      "value": "#AE431F",
      "source": "orange",
      "role": "AA warning text on pale warning surfaces"
    },
    "dangerText": {
      "value": "#A7332B",
      "source": "red",
      "role": "AA danger text on pale danger surfaces"
    }
  },
  "typography": {
    "family": {
      "sans": "Inter, ui-sans-serif, system-ui, sans-serif",
      "mono": "ui-monospace, SFMono-Regular, monospace"
    },
    "size": {
      "xs": "11px",
      "sm": "13px",
      "base": "16px",
      "lg": "18px",
      "xl": "24px",
      "h3": "clamp(24px, 2.4vw, 28px)",
      "h2": "clamp(36px, 4vw, 42px)",
      "display": "clamp(38px, 5vw, 64px)"
    },
    "weight": {
      "regular": 450,
      "medium": 650,
      "bold": 800,
      "black": 950
    },
    "lineHeight": {
      "tight": 0.96,
      "heading": 1.1,
      "body": 1.55
    }
  },
  "spacing": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px"
  },
  "radius": {
    "sm": "9px",
    "md": "12px",
    "lg": "16px",
    "xl": "24px",
    "pill": "999px"
  },
  "shadow": {
    "small": "0 8px 24px rgba(16,24,20,.08)",
    "card": "0 18px 55px rgba(16,24,20,.12)",
    "hero": "0 34px 90px rgba(16,24,20,.26)"
  },
  "layout": {
    "sidebar": "248px",
    "contentMax": "1280px",
    "recordRail": "320px",
    "clientSplitPane": "440px",
    "desktopBreakpoint": "900px",
    "mobileWidth": "390px"
  },
  "motion": {
    "fast": "120ms",
    "base": "180ms",
    "slow": "320ms",
    "easing": "cubic-bezier(.2,.8,.2,1)",
    "principles": [
      "Native scroll",
      "Only transform/opacity for decorative motion",
      "Pause offscreen/autoplay after two cycles",
      "prefers-reduced-motion renders final state",
      "No global scroll snap or wheel hijacking"
    ]
  },
  "density": {
    "public": "editorial spacious",
    "app": "compact but breathable",
    "touchTarget": "44px minimum"
  },
  "archetypes": [
    "Work queue",
    "List + preview",
    "Record + action rail",
    "Editor + live preview",
    "Inbox + review",
    "Calendar",
    "Analytical dashboard",
    "Guided setup"
  ]
}
